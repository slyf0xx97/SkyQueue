# The Streamlit app as a Vercel container function. Data comes from data/flights_extract.csv.gz.
FROM python:3.14-slim
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY . .
CMD streamlit run app/streamlit_app.py --server.port=${PORT:-80} --server.address=0.0.0.0 --browser.gatherUsageStats=false
